server {
    server_name emy-karate.de www.emy-karate.de;

    root /var/www/emy-karate; # Dein Pfad zur Homepage
    index index.php index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/emy-karate.de/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/emy-karate.de/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = www.emy-karate.de) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = emy-karate.de) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name emy-karate.de www.emy-karate.de;
    return 404; # managed by Certbot




}