app.post('/api/upload', upload.array('photos', 20), async (req, res) => {
  try {
    const gallery = readGallery();
    const added = [];

    for (const file of req.files) {
      const id = Date.now() + '-' + Math.random().toString(36).slice(2, 7);
      const filename = id + '.webp';
